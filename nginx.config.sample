# Ledarise Nginx sample
#
# Recommended production shape:
# - Docker Compose keeps frontend on 127.0.0.1:3000 and backend on 127.0.0.1:8080.
# - Nginx terminates TLS and exposes one public origin.
# - Build the frontend with PUBLIC_API_BASE_URL=https://your-domain.com
# - Set backend ALLOWED_ORIGINS=https://your-domain.com
#
# Install example:
#   sudo cp nginx.config.sample /etc/nginx/conf.d/ledarise.conf
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# Replace:
#   your-domain.com
#   /etc/letsencrypt/live/your-domain.com/fullchain.pem
#   /etc/letsencrypt/live/your-domain.com/privkey.pem

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream ledarise_frontend {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream ledarise_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;

    # Keep this location if Certbot uses webroot HTTP validation.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.com www.your-domain.com;

    ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 50m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # Backend health endpoint.
    location = /healthz {
        proxy_pass http://ledarise_backend;
    }

    # Go/Gin API routes:
    # - /api/v1/*
    # - /api/admin/*
    location /api/ {
        proxy_pass http://ledarise_backend;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Next.js app and static assets.
    location / {
        proxy_pass http://ledarise_frontend;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# Optional: separate API subdomain instead of same-origin /api.
# If you use this, build frontend with:
#   PUBLIC_API_BASE_URL=https://api.your-domain.com
# and set:
#   ALLOWED_ORIGINS=https://your-domain.com
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name api.your-domain.com;
#
#     ssl_certificate /etc/letsencrypt/live/api.your-domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/api.your-domain.com/privkey.pem;
#     client_max_body_size 50m;
#
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#
#     location / {
#         proxy_pass http://ledarise_backend;
#         proxy_read_timeout 120s;
#         proxy_send_timeout 120s;
#     }
# }
