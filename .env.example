# ────────────────────────────────────────────────────────────────────
# Ledarise — Docker Compose environment
# Copy to `.env` (same directory as docker-compose.yml) and adjust.
# ────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=jason6688
MYSQL_DATABASE=ledarise_db

# ── Auth (CHANGE BEFORE GOING TO PRODUCTION) ────────────────────────
JWT_SECRET=change_me_in_production_please_min_32_chars

# ── Public-facing URLs ──────────────────────────────────────────────
# The browser-facing URL of the backend. The frontend container writes this
# into /runtime-config.js at startup, so changing it only requires recreating
# the frontend container after the image includes runtime config support.
#
# Local dev:             http://localhost:8080
# Separate API domain:   https://api.your-domain.com
# Same-origin /api proxy: /
PUBLIC_API_BASE_URL=http://localhost:8080

# CORS whitelist for the backend (comma-separated, exact origin match).
# Should include the public origin where the frontend is served.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Host port mapping (override if 3000/8080 are taken) ─────────────
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ── Misc ────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
